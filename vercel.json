{
  "installCommand": "npm ci",
  "buildCommand": "npm run build:policyengine",
  "outputDirectory": "build",
  "redirects": [
    {
      "source": "/",
      "destination": "/us/obbba-household-explorer",
      "permanent": false
    },
    {
      "source": "/us/obbba-households",
      "destination": "/us/obbba-household-explorer",
      "permanent": false
    },
    {
      "source": "/us/obbba-households/:path*",
      "destination": "/us/obbba-household-explorer/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/us/obbba-household-explorer",
      "destination": "/index.html"
    },
    {
      "source": "/us/obbba-household-explorer/explore",
      "destination": "/index.html"
    },
    {
      "source": "/us/obbba-household-explorer/explore/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/us/obbba-household-explorer/:path*",
      "destination": "/:path*"
    }
  ]
}
